#REACT_APP_BILLING_SERVER_URL=''

REACT_APP_ADMIN_SERVER_URL='/admin'
# energystore is reached directly (same-origin) via the admin host's /energystore
# route; each environment's admin ingress must expose /energystore -> energystore.
REACT_APP_ENERGY_SERVER_URL='/energystore'
# eegfaktura-backend, only /api/bulkchange/... (Massenänderung); each environment's admin ingress exposes
# exactly that path -> backend.
REACT_APP_API_SERVER_URL='/api'
